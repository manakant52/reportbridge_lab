[Unit]
Description=WireGuard web portal
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tg_vpn_bot/tg_vpn_bot_project
EnvironmentFile=/opt/tg_vpn_bot/tg_vpn_bot_project/.env
ExecStart=/opt/tg_vpn_bot/tg_vpn_bot_project/.venv/bin/python /opt/tg_vpn_bot/tg_vpn_bot_project/app.py
Restart=always
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target

[Unit]
Description=WireGuard web portal in Podman
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/web_vpn_podman
ExecStart=/usr/bin/podman-compose up -d --build
ExecStop=/usr/bin/podman-compose down
TimeoutStartSec=0
User=root
Group=root

[Install]
WantedBy=multi-user.target
